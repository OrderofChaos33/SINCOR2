# ==============================================================================
# SINCOR2 Environment Configuration Template
# ==============================================================================
# Copy this to .env and fill in real values before deployment
# NEVER commit .env to version control
#
# Windows laptop: after copy, run:
#   powershell -ExecutionPolicy Bypass -File .\scripts\windows\fix-local-boot.ps1
# That remaps /data -> ./data and drops Redis unless Docker Redis is running.

# ==============================================================================
# Flask & Security
# ==============================================================================
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256

# ==============================================================================
# Admin Credentials (Change immediately after first login)
# ==============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!12345

# ==============================================================================
# Server Configuration
# ==============================================================================
PORT=8080
HOST=0.0.0.0
WORKERS=2
TIMEOUT=180
TRUST_PROXY=true
RAILWAY_ENVIRONMENT=

# ==============================================================================
# Database
# ==============================================================================
# Railway production: /data on the mounted volume.
# Local Windows: use ./data (fix-local-boot.ps1 will rewrite this).
SINCOR_DATA_DIR=./data
ORDERS_DB_PATH=./data/orders.db
DATABASE_URL=sqlite:///./data/orders.db
SINCOR_STORE_DB_PATH=./data/polyclaw.db
POLYCLAW_DB_PATH=./data/polyclaw.db

# PostgreSQL (optional, for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/sincor2

# ==============================================================================
# Async task queue (Celery + Redis)
# ==============================================================================
# Without REDIS_URL the web process falls back to an in-process thread pool
# so gunicorn still returns 202 instead of blocking for 180s.
# SINCOR_TASK_QUEUE=auto|celery|thread|eager   (eager is forced in FLASK_ENV=test)
# REDIS_URL=redis://localhost:6379/0
# REDIS_PRIVATE_URL=
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
SINCOR_TASK_QUEUE=thread
SINCOR_QUEUE_WORKERS=4
SINCOR_TASK_SOFT_LIMIT=540
SINCOR_TASK_HARD_LIMIT=600
A2A_TASK_STORE=sqlite

# A2A fabric shared state (P3 wave 15, G2.8): durable rate-limit
# counters + idempotency-key store shared across gunicorn workers.
# A2A_STATE_STORE=memory|sqlite|redis  (unset: sqlite in prod, memory in dev/test)
# redis honors REDIS_URL / REDIS_PRIVATE_URL (same as A2A_TASK_STORE=redis).
# When redis is configured but unreachable, requests are DENIED (503)
# rather than silently resetting counters — fail closed.
# A2A_STATE_STORE=sqlite
# A2A_STATE_SQLITE_PATH=/data/a2a_fabric_state.db
# SINCOR_LIMITER_STORAGE_URI=redis://localhost:6379/0   (app-wide flask-limiter)

# ==============================================================================
# API Keys & Integrations
# ==============================================================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
PAYPAL_REST_API_ID=
PAYPAL_REST_API_SECRET=
RESEND_API_KEY=
WALLETCONNECT_PROJECT_ID=

