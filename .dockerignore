# Git
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info
*.egg
dist
build
.eggs

# Virtual environments
.venv
venv
env

# IDE
.vscode
.idea
*.swp
*.swo

# Environment files
.env
.env.*
!.env.example

# Documentation
*.md
docs/*
# The two docs the discovery blueprint serves over HTTP must be in the
# image (/docs/TRUST_STACK.md, /docs/architecture/AUCTION_GROUND_TRUTH.md);
# a whole-directory "docs/" exclusion cannot be partially negated, so the
# exclusion is per-entry with explicit re-includes. Everything else under
# docs/ stays out.
!docs/TRUST_STACK.md
!docs/architecture
docs/architecture/*
!docs/architecture/AUCTION_GROUND_TRUTH.md
LICENSE

# Tests
tests/
test/
*.test.py
pytest.ini
.pytest_cache

# Misc
*.backup
*.bak
*.log
*.db-journal
money_assets/
node_modules/
.DS_Store
Thumbs.db

# CI/CD
.github/
.gitlab-ci.yml
