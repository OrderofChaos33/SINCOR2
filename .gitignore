# ============================================================================
# Environment
# ============================================================================
# Every .env* file is ignored at any depth; only the placeholder templates
# (.env.example) are tracked. Covers .env, .env.local, .env.production,
# .env.staging, .env.test, and any future .env.<environment> variant.
.env*
!.env.example

