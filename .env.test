# Test Environment Configuration
# ALL VALUES BELOW ARE FAKE PLACEHOLDERS. Never put real secrets in this file,
# not even "test" passwords that look real. runtime_secrets.py refuses to boot
# in production when it detects placeholder secrets.
FLASK_ENV=testing
FLASK_DEBUG=false
SECRET_KEY=test-only-fake-secret-key-not-a-real-secret
JWT_SECRET_KEY=test-only-fake-jwt-secret-not-a-real-secret
ADMIN_USERNAME=testadmin
ADMIN_PASSWORD=test-only-fake-password-not-a-real-password
PORT=5000
DATABASE_URL=sqlite:///:memory:
SINCOR_DATA_DIR=/tmp/sincor_test
ORDERS_DB_PATH=/tmp/sincor_test/orders.db
LOG_LEVEL=DEBUG
OAUTH_REDIRECT_BASE_URL=http://localhost:5000
