# P22 Concentrated Liquidity Manager — example config (PACK-3).
# Copy into the deployer's environment inside a signed engagement only.
# All values are read at import time by the core module.
# Defaults shown are the module's own defaults; see DEPLOY.md.

# Treasury recorded for the proceeds-distribution treasury cut.
# Set to the engagement's agreed treasury address before any drill.
TREASURY_ADDRESS=0x09E2891432827D8835d2E9b83B25e2a5ba9612Ac

# Volatility band / tick-shift behaviour (ticks).
CLMM_VOL_BAND_TICKS=240
CLMM_TICK_SHIFT_STEP=60

# JIT flag threshold: prefer the integer bps form (9500 = 95%).
CLMM_JIT_SENSITIVITY_BPS=9500
# Legacy alternative (parsed exactly via Decimal): CLMM_JIT_SENSITIVITY=0.95

CLMM_COOLDOWN_BLOCKS=10
CLMM_MAX_SHIFT_TICKS=480

# Transient JIT surcharge cap (bps).
CLMM_JIT_FEE_CAP_BPS=100

# Dry-run stays ON for the drill. Setting 0 does not by itself enable
# live positions; the auditor gate is a separate signed step.
CLMM_DRY_RUN=1
