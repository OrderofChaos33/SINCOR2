# P25 DeFi Risk Mutual — annotated config surface (PACK-3)
# Copy the names you need into your deployment environment inside a signed
# engagement. This file contains no secrets and no real keys.
# Both variables are read once, at module import time.

# Treasury address that receives the 25 bps premium fee at collection.
# Default in code (insurance_mutual.TREASURY):
TREASURY_ADDRESS=0x09E2891432827D8835d2E9b83B25e2a5ba9612Ac

# Dry-run flag. "1" (default) = dry-run; "0" = not dry-run.
# Note: in this reference build the flag is read at import but no method
# branches on it — see DEPLOY.md §2 for the exact behavior.
MUTUAL_DRY_RUN=1
