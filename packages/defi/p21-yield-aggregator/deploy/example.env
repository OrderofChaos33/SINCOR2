# P21 Yield Aggregator Vault — example configuration.
# Copy to .env inside a signed engagement and replace addresses with
# the values agreed in that engagement. Never put signing keys here.

# Treasury the internal protocol-fee concept routes to.
TREASURY_ADDRESS=0x09E2891432827D8835d2E9b83B25e2a5ba9612Ac

# SINCOR SharedLiquidityVault + hook. The shared-liquidity strategy
# ships disabled; see DEPLOY.md step 6 before any change.
SHARED_LIQUIDITY_VAULT=0xeA90a257e5Dae20a0472C4812775F28614459bb6
SHARED_LIQUIDITY_HOOK=0x5A20BfEc6Caa3A94246eCCCb36F27F4980152dC0

# Morpho Gauntlet USDC Prime vault (Base mainnet address shown;
# use the Sepolia address agreed in the engagement for drills).
MORPHO_USDC_VAULT=0xeE8F4eC5672F09119b96Ab6fB59C27E1b7e44b61

# 0 = dry-run plans only. 1 = live-intent payloads (external signer
# still required; this module never signs or broadcasts).
EXECUTE_LIVE=0

# Risk caps.
YIELD_MAX_SINGLE_STRATEGY_PCT=0.40
YIELD_MAX_SLIPPAGE_BPS=50
YIELD_MIN_CAPITAL_USD=1.0
