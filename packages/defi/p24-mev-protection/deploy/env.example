# P24 — MEV Protection & Capture (suite P04): configuration surface.
# Copy into the engagement environment and set values there.
# This is the module's COMPLETE environment surface (see DEPLOY.md);
# the module reads no other variables and no network endpoints.

# Treasury address: signer deny-list entry / reference routing
# destination. Must never appear in any signer/key/EOA/wallet field.
TREASURY_ADDRESS=0x09E2891432827D8835d2E9b83B25e2a5ba9612Ac

# Flow gate — notional limb (USD).
MEV_FLOW_THRESHOLD_USD=1000.0

# Flow gate — impact limb (bps, absolute).
MEV_IMPACT_FLAG_BPS=50

# Minimum float for the reference simulation objects (bookkeeping only).
MEV_MIN_FLOAT_USD=100.0

# Dry-run marker. Keep at 1 for all engagement work.
MEV_DRY_RUN=1
