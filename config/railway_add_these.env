# Railway → web service → Variables
# Volume: mount /data

SINCOR_DATA_DIR=/data
WEBBUILDER_DATA_DIR=/data/webbuilder
ORDERS_DB_PATH=/data/orders.db

# Master — agents only, no HITL sales
AUTONOMOUS_AGENTS=true
OUTREACH_ENABLED=true
OUTREACH_INTERVAL_HOURS=2
OUTREACH_DAILY_LIMIT=40
OUTREACH_FROM_NAME=SINCOR Agent
OUTREACH_FROM_EMAIL=support@getsincor.com
CONTENT_AGENT_ENABLED=true
RECURSIVE_OPTIMIZER_ENABLED=true
LAUNCH_OPS_ENABLED=true
DAILY_OPS_ENABLED=true
SADAS_ENABLED=true

# Safety — on-chain writes stay local unless you set keys
AGENT_BURN_AUTO=false
ALLOW_ONCHAIN_WRITES=false
SAFETY_OVERRIDE=false
EXECUTE_LIVE=0

LEGACY_FIAT_PAYMENTS_ENABLED=false
PLATFORM_TREASURY_ADDRESS=0x09E2891432827D8835d2E9b83B25e2a5ba9612Ac
TREASURY_ADDRESS=0x09E2891432827D8835d2E9b83B25e2a5ba9612Ac
BASE_RPC_URL=
AXM_REPORT_PRICE=500
ADMIN_USERNAME=
ADMIN_PASSWORD=

POLYCLAW_ENABLED=true
POLYCLAW_AUTO_EXECUTE=false
POLYCLAW_CAPITAL=300
TREASURY_CONVERSION_ENABLED=true
TREASURY_TARGET_ASSET=USDC

COMPLIANCE_MONITOR_ENABLED=true
COMPLIANCE_CONFIDENTIAL=true
COMPLIANCE_LOG_TO_STDOUT=false

LAUNCH_OPS_INTERVAL_HOURS=24
LAUNCH_REVIEW_ALERT_EMAIL=eenergy@protonmail.com
LAUNCH_REVIEW_REMINDER_ENABLED=false
LAUNCH_REVIEW_REMINDER_AFTER_CYCLE=false
DAILY_OPS_INTERVAL_HOURS=24
SUBSCRIPTION_REMINDER_ENABLED=true

RESEND_API_KEY=
SUPPORT_EMAIL=support@getsincor.com
YELP_API_KEY=
GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=https://getsincor.com
TRUST_PROXY=true

PARTNER_OUTREACH_ENABLED=true
WALLETCONNECT_PROJECT_ID=
